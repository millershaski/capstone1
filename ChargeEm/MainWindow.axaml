<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ChargeEmQuoteUI.MainWindow"
        Title="ChargeEm — Life Insurance Quotation"
        Width="1160" Height="860"
        MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8"
        Foreground="#172D44"
        FontSize="14">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DEE5ED" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#586A7E" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.quoteLabel">
      <Setter Property="Foreground" Value="#586A7E" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.quoteValue">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderBrush" Value="#BAC7D5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Company header. -->
    <Border Grid.Row="0" Background="White"
            BorderBrush="#DEE5ED" BorderThickness="0,0,0,1"
            Padding="28,19">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="13">
          <Border Width="44" Height="44" CornerRadius="10" Background="#172D44">
            <TextBlock Text="CE" FontSize="17" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="ChargEm" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Life Insurance Company" Classes="muted" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="#E7F4F3" CornerRadius="6"
                Padding="12,8" VerticalAlignment="Center">
          <TextBlock Text="Annual policy quotation" Foreground="#00676C"
                     FontSize="12" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <!-- Both entry and quotation remain on the same screen.
         Scrolling keeps all fields reachable on shorter displays. -->
    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Margin="28,24" ColumnDefinitions="1.2*,22,*">
        <StackPanel Grid.Column="0" Spacing="18">

          <!-- Customer inputs. Numeric parsing and validation are left to you. -->
          <Border Classes="card">
            <StackPanel Spacing="18">
              <StackPanel Spacing="5">
                <TextBlock Text="Customer information" Classes="sectionTitle" />
                <TextBlock Text="Enter the customer's name and personal details."
                           Classes="muted" />
              </StackPanel>

              <Grid ColumnDefinitions="*,12,78,12,*">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="First name" Classes="fieldLabel" />
                  <TextBox x:Name="FirstNameTextBox" Watermark="First name"
                           AutomationProperties.Name="First name" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Middle initial" Classes="fieldLabel" FontSize="12" />
                  <TextBox x:Name="MiddleInitialTextBox" Watermark="M" MaxLength="1"
                           AutomationProperties.Name="Middle initial" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="Last name" Classes="fieldLabel" />
                  <TextBox x:Name="LastNameTextBox" Watermark="Last name"
                           AutomationProperties.Name="Last name" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,12,*,12,*">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Age (years)" Classes="fieldLabel" />
                  <TextBox x:Name="AgeTextBox" Watermark="Years"
                           AutomationProperties.Name="Age in years" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Height (inches)" Classes="fieldLabel" />
                  <TextBox x:Name="HeightTextBox" Watermark="Inches"
                           AutomationProperties.Name="Height in inches" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="Weight (pounds)" Classes="fieldLabel" />
                  <TextBox x:Name="WeightTextBox" Watermark="Pounds"
                           AutomationProperties.Name="Weight in pounds" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- GroupName enforces one discount choice; bindings only enable UI. -->
          <Border Classes="card">
            <StackPanel Spacing="16">
              <TextBlock Text="Coverage &amp; discounts" Classes="sectionTitle" />

              <StackPanel>
                <TextBlock Text="Coverage amount ($)" Classes="fieldLabel" />
                <TextBox x:Name="CoverageAmountTextBox" Watermark="e.g., 100000"
                         AutomationProperties.Name="Policy coverage amount in dollars" />
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="Discount type" Classes="fieldLabel" Margin="0" />
                <WrapPanel Orientation="Horizontal">
                  <RadioButton x:Name="NoDiscountRadioButton"
                               GroupName="DiscountType" IsChecked="True"
                               Content="None" Margin="0,0,18,0" />
                  <RadioButton x:Name="PercentageDiscountRadioButton"
                               GroupName="DiscountType"
                               Content="Percentage" Margin="0,0,18,0" />
                  <RadioButton x:Name="FlatDiscountRadioButton"
                               GroupName="DiscountType" Content="Flat amount" />
                </WrapPanel>
              </StackPanel>

              <Grid ColumnDefinitions="*,14,*">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Percentage discount (%)" Classes="fieldLabel" />
                  <TextBox x:Name="PercentageDiscountTextBox" Watermark="e.g., 5"
                           IsEnabled="{Binding #PercentageDiscountRadioButton.IsChecked}"
                           AutomationProperties.Name="Percentage discount" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Flat discount ($)" Classes="fieldLabel" />
                  <TextBox x:Name="FlatDiscountTextBox" Watermark="e.g., 100"
                           IsEnabled="{Binding #FlatDiscountRadioButton.IsChecked}"
                           AutomationProperties.Name="Flat dollar discount" />
                </StackPanel>
              </Grid>
              <TextBlock Text="Select one discount type, or choose None."
                         Classes="muted" />
            </StackPanel>
          </Border>

          <!-- Set the message and show this border in your validation code. -->
          <Border x:Name="ValidationBorder" IsVisible="False"
                  Background="#FFF2F0" BorderBrush="#EDC0B9" BorderThickness="1"
                  CornerRadius="8" Padding="16">
            <StackPanel Spacing="5">
              <TextBlock Text="Please review the entered details."
                         Foreground="#9D3025" FontWeight="SemiBold" />
              <TextBlock x:Name="ValidationMessageTextBlock" Text=""
                         Foreground="#9D3025" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Output placeholders: assign their Text properties from your C# code. -->
        <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
          <StackPanel Spacing="18">
            <TextBlock Text="Policy quotation" Classes="sectionTitle" />

            <StackPanel Spacing="5">
              <TextBlock Text="PREPARED FOR" Classes="muted" FontSize="11" />
              <TextBlock x:Name="CustomerNameTextBlock" Text="—"
                         FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="*,16,*">
              <TextBlock Text="Coverage amount" Classes="quoteLabel" />
              <TextBlock Grid.Column="2" x:Name="CoverageAmountTextBlock"
                         Text="—" Classes="quoteValue" />
            </Grid>

            <Border Background="#F1F5F9" CornerRadius="8" Padding="16">
              <Grid ColumnDefinitions="*,18,*">
                <StackPanel Spacing="8">
                  <TextBlock Text="Risk factor" Classes="muted" />
                  <TextBlock x:Name="RiskFactorTextBlock" Text="—"
                             FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Text="Safe / unsafe" Classes="muted" />
                  <TextBlock x:Name="RiskCategoryTextBlock" Text="—"
                             FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="1.5*,16,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Text="Cost per $1,000" Classes="quoteLabel"
                         Margin="0,0,0,14" />
              <TextBlock Grid.Row="0" Grid.Column="2" x:Name="CostPerThousandTextBlock"
                         Text="—" Classes="quoteValue" Margin="0,0,0,14" />

              <TextBlock Grid.Row="1" Text="Annual premium" Classes="quoteLabel"
                         Margin="0,0,0,14" />
              <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AnnualPremiumTextBlock"
                         Text="—" Classes="quoteValue" Margin="0,0,0,14" />

              <TextBlock Grid.Row="2" Text="Discount" Classes="quoteLabel"
                         Margin="0,0,0,14" />
              <TextBlock Grid.Row="2" Grid.Column="2" x:Name="DiscountAmountTextBlock"
                         Text="—" Classes="quoteValue" Margin="0,0,0,14" />

              <TextBlock Grid.Row="3" Text="Premium after discount" Classes="quoteLabel"
                         TextWrapping="Wrap" Margin="0,0,0,14" />
              <TextBlock Grid.Row="3" Grid.Column="2" x:Name="SubtotalTextBlock"
                         Text="—" Classes="quoteValue" Margin="0,0,0,14" />

              <TextBlock Grid.Row="4" Text="Michigan sales tax" Classes="quoteLabel"
                         TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Grid.Column="2" x:Name="SalesTaxTextBlock"
                         Text="—" Classes="quoteValue" />
            </Grid>

            <Border Background="#172D44" CornerRadius="8" Padding="20,17">
              <StackPanel Spacing="7">
                <TextBlock Text="TOTAL ANNUAL PREMIUM" Foreground="#D6E4F0"
                           FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="TotalAnnualPremiumTextBlock" Text="—"
                           Foreground="White" FontSize="32" FontWeight="Bold"
                           TextWrapping="Wrap" />
                <TextBlock Text="Including discount and sales tax"
                           Foreground="#D6E4F0" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TextBlock x:Name="QuoteStatusTextBlock" Text="No quote generated."
                       Classes="muted" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <!-- All three handlers are intentionally empty in MainWindow.axaml.cs. -->
    <Border Grid.Row="2" Background="White" Padding="28,16"
            BorderBrush="#DEE5ED" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Review customer details before generating a quote."
                   Classes="muted" VerticalAlignment="Center" Margin="0,0,20,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <Button x:Name="ExitButton" Content="Exit" Click="ExitButton_Click" />
          <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
          <Button x:Name="GenerateQuoteButton" Content="Generate quote" Classes="accent"
                  IsDefault="True" Click="GenerateQuoteButton_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
